---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { homeWritingStatus } from "@/data/home-status";
import type { TermPost } from "@/scripts/home-term";
import { useTranslations } from "@/i18n";

type Props = {
  locale: string;
  posts: TermPost[];
  ideas?: string[];
};

const { locale, posts, ideas = [] } = Astro.props;
const postsHref = getRelativeLocaleUrl(locale, "posts");
const aboutHref = getRelativeLocaleUrl(locale, "about");
const prompt = "duang@blog:~$";
const author = config.site.author;
const t = useTranslations(locale);
---

<section
  id="hero"
  class="home-hero border-border relative flex min-h-svh items-center justify-center overflow-hidden border-b pt-20"
  aria-labelledby="home-brand"
  data-posts-href={postsHref}
  data-about-href={aboutHref}
  data-author={author}
  data-posts={JSON.stringify(posts)}
  data-ideas={JSON.stringify(ideas)}
  data-writing={homeWritingStatus.text}
  data-prompt={prompt}
>
  <div class="home-hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div
    id="home-boot"
    class="home-boot font-mono text-foreground fixed inset-0 z-50 flex items-center justify-center bg-background px-6"
    aria-hidden="true"
  >
    <pre id="home-boot-log" class="text-muted-foreground w-full max-w-xl text-xs leading-6 sm:text-sm"></pre>
  </div>

  <div class="app-layout relative z-10 w-full py-12">
    <div id="home-hero-stage" class="home-hero-stage mx-auto w-full max-w-2xl opacity-0">
      <div
        class="home-term border-border bg-background/85 font-mono overflow-hidden rounded-xl border shadow-sm backdrop-blur"
      >
        <div class="border-border bg-muted/60 flex items-center justify-between gap-2 border-b px-4 py-2.5">
          <div class="flex items-center gap-2">
            <span class="bg-accent/80 size-3 rounded-full"></span>
            <span class="bg-muted-foreground/45 size-3 rounded-full"></span>
            <span class="bg-muted-foreground/25 size-3 rounded-full"></span>
            <span class="text-muted-foreground ms-2 text-xs" data-term-chrome-prompt
              >{prompt}</span
            >
          </div>
          <button
            type="button"
            id="home-term-sound"
            class="text-muted-foreground hover:text-accent text-[11px] tracking-wide"
            aria-pressed="true"
            title="切换按键音"
          >
            sound on
          </button>
        </div>

        <div
          id="home-term-body"
          class="home-term-body text-foreground max-h-[min(28rem,52svh)] min-h-[16rem] overflow-y-auto px-4 py-4 text-sm leading-7 sm:text-base"
          tabindex="0"
          role="application"
          aria-label="交互终端"
        >
          <h1 id="home-brand" class="sr-only">{config.site.title}</h1>
        </div>
      </div>

      <p class="text-muted-foreground mt-5 text-center text-xs tracking-wide">
        help · grep · cat · today · 也可把文章拖进终端
      </p>
    </div>
  </div>

  <a
    href="#posts"
    class="home-hero-scroll text-muted-foreground hover:text-accent absolute inset-x-0 bottom-6 z-10 mx-auto flex w-fit flex-col items-center gap-1 text-xs tracking-wide"
    aria-label={t.home.scrollToPosts}
  >
    <span>{t.home.scrollToPosts}</span>
    <span class="home-hero-scroll-cue border-border block h-8 w-px border-l" aria-hidden="true"></span>
  </a>
</section>

<style is:global>
  /* Only the site chrome <header>, not column section headers. */
  body:has(main[data-layout="index"]) > header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 40;
    transition:
      background-color 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  body:has(main[data-layout="index"]) > header > div {
    background: transparent;
    border-bottom-color: transparent;
    transition: border-color 0.25s ease;
  }

  body:has(main[data-layout="index"]) > header.home-header-solid,
  body:has(main[data-layout="index"]) > header:has(#menu-items:not(.hidden)) {
    background: color-mix(in oklab, var(--background) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  body:has(main[data-layout="index"]) > header.home-header-solid > div {
    border-bottom-color: var(--border);
  }

  body.home-paper-wrinkle::before {
    animation: home-paper-wrinkle 0.18s ease;
  }

  @keyframes home-paper-wrinkle {
    0%,
    100% {
      opacity: 0.035;
      transform: none;
    }
    40% {
      opacity: 0.06;
      transform: scale(1.003);
    }
  }
</style>

<style>
  .home-hero-glow {
    background: radial-gradient(
      60% 50% at 50% 38%,
      color-mix(in oklab, var(--accent) 14%, transparent),
      transparent 70%
    );
  }

  .home-boot {
    /* Cover the whole viewport so below-hero notes / VT ghosts never peek. */
    transition: opacity 0.35s ease;
  }

  .home-boot.is-done {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  :global(body.is-home-booting) {
    overflow: hidden;
  }

  :global(body.is-home-booting .home-aside-notes-wrap),
  :global(body.is-home-booting .home-columns),
  :global(body.is-home-booting .home-seam),
  :global(body.is-home-booting #posts) {
    visibility: hidden;
  }

  .home-hero-stage {
    will-change: opacity, transform;
    transition: opacity 0.4s ease;
  }

  .home-hero-stage.is-ready {
    opacity: 1;
  }

  .home-term {
    transition:
      filter 0.08s ease,
      box-shadow 0.08s ease;
  }

  .home-term.is-flicker {
    filter: contrast(1.05) brightness(1.03);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 25%, transparent);
  }

  :global(.home-term-body.is-drop-target),
  :global(.home-term-body.is-drop-hint) {
    outline: 1px dashed color-mix(in oklab, var(--accent) 55%, transparent);
    outline-offset: -6px;
    background: color-mix(in oklab, var(--accent) 6%, transparent);
  }

  .home-term-line {
    white-space: pre-wrap;
    word-break: break-word;
  }

  :global(.home-term-cursor) {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    margin-inline-start: 1px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: home-term-blink 1.05s step-end infinite;
  }

  :global(.home-term-input) {
    background: transparent;
    border: 0;
    outline: none;
    color: inherit;
    font: inherit;
    flex: 0 1 auto;
    width: auto;
    min-width: 1ch;
    field-sizing: content;
    caret-color: transparent;
  }

  :global(.home-term-prompt-row) {
    display: flex;
    align-items: baseline;
    gap: 0.35ch;
    width: 100%;
  }

  :global(.home-term-prompt-row .home-term-cursor) {
    flex: 0 0 auto;
  }

  .home-hero-scroll {
    opacity: 0;
  }

  .home-hero-scroll.is-ready {
    animation: home-term-in 0.6s ease forwards;
  }

  .home-hero-scroll-cue {
    transform-origin: top;
    animation: home-hero-cue 1.6s ease-in-out infinite;
  }

  @keyframes home-term-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes home-term-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  @keyframes home-hero-cue {
    0%,
    100% {
      opacity: 0.35;
      transform: scaleY(0.65);
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-boot {
      transition: none;
    }
    :global(.home-term-cursor),
    .home-hero-scroll-cue {
      animation: none;
    }
    .home-hero-scroll.is-ready {
      opacity: 1;
      animation: none;
    }
    .home-term.is-flicker {
      filter: none;
      box-shadow: none;
    }
  }
</style>

<script>
  import { bindHomeHeroPageLoad } from "@/scripts/home-term";
  bindHomeHeroPageLoad();
</script>
