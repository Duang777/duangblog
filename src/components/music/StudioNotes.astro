---
import OnTheLaptop from "@/assets/music/oc-on-the-laptop.svg";
import IntoTheWork from "@/assets/music/nc-sucking-into-the-work.svg";
import TimeFlies from "@/assets/music/oc-time-flies.svg";
import Microphone from "@/assets/music/ni-microphone.svg";
import Recording from "@/assets/music/ni-recording.svg";
---

<section class="mx-studio" aria-labelledby="mx-studio-title">
  <header class="mx-section-head" data-reveal>
    <h2 id="mx-studio-title" class="mx-section-title">在做什么</h2>
  </header>

  <ul class="mx-studio-grid">
    <li class="mx-card" data-reveal>
      <OnTheLaptop class="mx-card-art" aria-hidden="true" />
      <p class="mx-card-label">
        <Microphone class="mx-card-icon" aria-hidden="true" />正在录
      </p>
      <p class="mx-card-line">小样一段一段录，先存成草稿。</p>
    </li>
    <li class="mx-card" data-reveal>
      <IntoTheWork class="mx-card-art" aria-hidden="true" />
      <p class="mx-card-label">
        <Recording class="mx-card-icon" aria-hidden="true" />深夜混音
      </p>
      <p class="mx-card-line">耳机音量放低，一轨一轨对电平。</p>
    </li>
    <li class="mx-card" data-reveal>
      <TimeFlies class="mx-card-art" aria-hidden="true" />
      <p class="mx-card-label">下一张</p>
      <p class="mx-card-line">还在攒曲子，攒够一面再说。</p>
    </li>
  </ul>
</section>
