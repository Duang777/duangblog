---
/** Site brand mark beside Duang. Three.js mounts after first paint / idle. */
---

<div
  class="brand-logo-badge"
  data-brand-logo-3d
  transition:persist="brand-logo-3d"
  role="img"
  aria-label="品牌标识，拖拽旋转，双击复原"
  title="拖拽旋转 · 双击复原"
>
</div>

<style>
  .brand-logo-badge {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    touch-action: none;
    opacity: 0.92;
    transform: translateY(0.06em);
  }

  .brand-logo-badge :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  @media (min-width: 640px) {
    .brand-logo-badge {
      width: 3.25rem;
      height: 3.25rem;
      transform: translateY(0.04em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo-badge {
      display: none;
    }
  }
</style>

<script>
  let dispose: (() => void) | null = null;
  let observer: IntersectionObserver | null = null;
  let mountedStage: HTMLElement | null = null;
  let idleHandle: number | null = null;

  function cancelIdle() {
    if (idleHandle == null) return;
    if (typeof cancelIdleCallback === "function") {
      cancelIdleCallback(idleHandle);
    } else {
      window.clearTimeout(idleHandle);
    }
    idleHandle = null;
  }

  function whenIdle(fn: () => void, timeout = 2200) {
    cancelIdle();
    if (typeof requestIdleCallback === "function") {
      idleHandle = requestIdleCallback(
        () => {
          idleHandle = null;
          fn();
        },
        { timeout }
      );
      return;
    }
    idleHandle = window.setTimeout(() => {
      idleHandle = null;
      fn();
    }, 350);
  }

  function teardown() {
    cancelIdle();
    observer?.disconnect();
    observer = null;
    dispose?.();
    dispose = null;
    if (mountedStage) {
      mountedStage.dataset.logoMounted = "0";
      mountedStage = null;
    }
  }

  async function mountLogo(stage: HTMLElement) {
    if (dispose) return;
    const { mountAboutLogo } = await import(
      "@/components/about-logo-3d/load-about-logo.ts"
    );
    if (dispose) return;
    if (!document.contains(stage)) return;
    dispose = mountAboutLogo(stage, { compact: true });
    mountedStage = stage;
    stage.dataset.logoMounted = "1";
  }

  async function boot() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const stage = document.querySelector<HTMLElement>("[data-brand-logo-3d]");
    if (!stage) return;

    // Soft navigations keep the persisted node + Three.js instance.
    if (
      dispose &&
      mountedStage === stage &&
      (stage.dataset.logoMounted === "1" || stage.querySelector("canvas"))
    ) {
      return;
    }

    teardown();

    observer = new IntersectionObserver(
      entries => {
        const entry = entries[0];
        if (!entry?.isIntersecting || dispose) return;
        observer?.disconnect();
        observer = null;
        // Wait until the browser is idle so article text can paint first.
        whenIdle(() => {
          void mountLogo(stage);
        });
      },
      { rootMargin: "0px", threshold: 0 }
    );
    observer.observe(stage);
  }

  document.addEventListener("astro:page-load", boot);
  // Do not teardown on soft swaps: the badge uses transition:persist.
</script>
