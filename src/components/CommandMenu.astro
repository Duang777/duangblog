---
// Header search entry, replaced by a BEUI Command Palette (⌘K).
// The trigger button is plain SSR HTML (visible without JS); the palette
// itself is a client-only React island so it never pulls in Astro's
// `astro:jsx` SSR virtual module during the static build.
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { getHomeColumns } from "@/data/home-columns";
import { SiteCommandMenu } from "@/components/beui/SiteCommandMenu";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const columns = getHomeColumns(locale);
const navItems = [
  {
    id: "home",
    label: t.nav.home,
    group: t.command.navGroup,
    href: getRelativeLocaleUrl(locale, ""),
    icon: "home",
  },
  {
    id: "posts",
    label: t.nav.posts,
    group: t.command.navGroup,
    href: getRelativeLocaleUrl(locale, "posts"),
    icon: "posts",
  },
  {
    id: "tags",
    label: t.nav.tags,
    group: t.command.navGroup,
    href: getRelativeLocaleUrl(locale, "tags"),
    icon: "tags",
  },
  {
    id: "archives",
    label: t.nav.archives,
    group: t.command.navGroup,
    href: getRelativeLocaleUrl(locale, "archives"),
    icon: "archive",
  },
  {
    id: "about",
    label: t.nav.about,
    group: t.command.navGroup,
    href: getRelativeLocaleUrl(locale, "about"),
    icon: "about",
  },
  ...columns.map(c => {
    const href = c.hubSlug
      ? getPostUrl(c.hubSlug, undefined, locale)
      : c.tagHrefName
        ? getRelativeLocaleUrl(locale, `tags/${slugifyStr(c.tagHrefName)}`)
        : getRelativeLocaleUrl(locale, "posts");
    return {
      id: `col-${c.id}`,
      label: c.title,
      group: t.command.columnGroup,
      href,
      icon: "column",
    };
  }),
];

const posts = await getCollection("posts");
const recentPosts = getSortedPosts(posts, locale)
  .slice(0, 6)
  .map(p => ({
    label: p.data.title,
    href: getPostUrl(p.id, p.filePath, locale),
  }));

// Same shape Layout writes into `body[data-search-href]` for the `/` hotkey.
// The palette cannot search article text, so its pinned row hands off here.
const searchHref =
  config.features.search === "pagefind"
    ? getRelativeLocaleUrl(locale, "search")
    : undefined;
---

<button
  type="button"
  id="site-command-trigger"
  class="focus-outline text-muted-foreground hover:text-accent relative flex size-8 items-center justify-center rounded-full transition-colors"
  aria-label={t.nav.search}
  title={`${t.nav.search} (⌘K)`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <span class="sr-only">{t.nav.search}</span>
</button>

<SiteCommandMenu
  client:only="react"
  nav={navItems}
  recent={recentPosts}
  recentGroup={t.command.recentGroup}
  placeholder={t.a11y.searchPlaceholder}
  emptyMessage={t.a11y.noResults}
  searchHref={searchHref}
  fullSearchLabel={t.command.fullSearch}
  fullSearchLabelEmpty={t.command.fullSearchEmpty}
/>

<script>
  const btn = document.getElementById("site-command-trigger");
  btn?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("open-site-command-menu"));
  });
</script>
