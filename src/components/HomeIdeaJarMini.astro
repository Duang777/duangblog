---
/** Archives / list pages — liquid level only. */
type Props = {
  totalPosts: number;
};

const { totalPosts } = Astro.props;
---

<div
  class="idea-jar-mini"
  data-total-posts={totalPosts}
  data-pagefind-ignore
  title="念头瓶液位"
  aria-hidden="true"
>
  <svg
    class="idea-jar-mini-svg"
    viewBox="0 0 56 84"
    width="56"
    height="84"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="jar-mini-liquid" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" class="jar-stop-liquid-deep" />
        <stop offset="100%" class="jar-stop-liquid-surface" />
      </linearGradient>
      <clipPath id="jar-mini-clip">
        <path
          d="M 16 30 C 14 30 13 31.5 13 33 V 62 C 13 68 18 71 28 71 C 38 71 43 68 43 62 V 33 C 43 31.5 42 30 40 30 Z"
        />
      </clipPath>
    </defs>
    <rect x="18" y="8" width="20" height="5" rx="1" class="jar-mini-lid" />
    <path
      class="jar-mini-glass"
      d="M 16 30 C 14 30 13 31.5 13 33 V 62 C 13 68 18 71 28 71 C 38 71 43 68 43 62 V 33 C 43 31.5 42 30 40 30 C 38 26 34 24 28 24 C 22 24 18 26 16 30 Z"
    />
    <g clip-path="url(#jar-mini-clip)">
      <g class="jar-liquid-fill" transform="translate(28 68) scale(1 0.08)">
        <rect x="-14" y="-40" width="28" height="40" fill="url(#jar-mini-liquid)" />
      </g>
    </g>
  </svg>
</div>

<script>
  import { initIdeaJars } from "@/scripts/bind-idea-jar";
  document.addEventListener("astro:page-load", initIdeaJars);
</script>
