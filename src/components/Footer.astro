---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();

// A short notebook-style path for the current page, like a page footer stamp.
const locale = Astro.currentLocale ?? config.site.lang;
const rawPath = stripLocale(stripBase(Astro.url.pathname), locale)
  .replace(/\/+$/, "");
const shortPath = rawPath === "" ? "~" : `~${rawPath}`;
const generatedAt = new Date().toISOString().slice(0, 16).replace("T", " ");
const rssHref = getRelativeLocaleUrl(locale, "rss.xml");
---

<!-- generated-at: {generatedAt} UTC -->
<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  data-generated-at={generatedAt}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <div class="flex flex-col items-center gap-1 sm:items-end">
      <Socials />
      <a href={rssHref} class="footer-rss-note font-mono">可订阅 · 不吵</a>
    </div>
    <div class="my-2 flex flex-col items-center gap-1 sm:flex-row sm:gap-0">
      <button
        type="button"
        class="footer-path font-mono text-muted-foreground text-xs tracking-wide"
        data-path={shortPath}
        title="点击复制路径"
      >
        {config.site.author} · 笔记 <span class="opacity-60">·</span>
        <span class="text-accent/80 footer-path-value">{shortPath}</span>
      </button>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span class="whitespace-nowrap">
        {t.footer.copyright} &#169; {currentYear}
      </span>
    </div>
  </div>
</footer>

<script>
  function bindFooterPathCopy() {
    const btn = document.querySelector<HTMLButtonElement>(".footer-path");
    if (!btn || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";
    const value = btn.querySelector(".footer-path-value");
    btn.addEventListener("click", async () => {
      const path = btn.dataset.path ?? "~";
      try {
        await navigator.clipboard.writeText(path);
        if (value) {
          const prev = value.textContent;
          value.textContent = "已复制";
          window.setTimeout(() => {
            value.textContent = prev;
          }, 800);
        }
      } catch {
        // ignore
      }
    });
  }
  document.addEventListener("astro:page-load", bindFooterPathCopy);
  bindFooterPathCopy();
</script>
