---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  backLabel?: string;
};

const { pageTitle, pageDesc, class: className, backLabel } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  data-back-label={backLabel}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <h1 class="text-2xl font-semibold sm:text-3xl">{pageTitle}</h1>
  <p class="mt-2 mb-6 italic">{pageDesc}</p>
  <slot />
</main>

<script>
  import { applyReadEcho } from "@/scripts/home-term";

  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
    const backLabel = mainContent?.dataset?.backLabel;
    if (backLabel) {
      sessionStorage.setItem("backLabel", backLabel);
    } else {
      sessionStorage.removeItem("backLabel");
    }

    if (mainContent?.querySelector(".post-card")) {
      applyReadEcho(mainContent);
    }
  });
</script>
