---
/**
 * Notebook binding thread along the page edge.
 * The stitch marker follows scroll depth; decorative only.
 */
---

<div class="home-thread" aria-hidden="true">
  <span class="home-thread-line"></span>
  <span class="home-thread-stitch"></span>
</div>

<style>
  .home-thread {
    position: fixed;
    inset-block: 5.5rem 3.5rem;
    inset-inline-start: max(0.75rem, calc((100vw - var(--thread-span, 48rem)) / 4));
    z-index: 5;
    width: 1px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .home-thread.is-ready {
    opacity: 1;
  }

  .home-thread-line {
    position: absolute;
    inset: 0;
    border-inline-start: 1px dashed
      color-mix(in oklab, var(--border) 75%, transparent);
  }

  .home-thread-stitch {
    position: absolute;
    inset-inline-start: 50%;
    top: calc(var(--thread-progress, 0) * 100%);
    width: 5px;
    height: 5px;
    margin-inline-start: -2.5px;
    margin-top: -2.5px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 70%, transparent);
  }

  @media (max-width: 1180px) {
    .home-thread {
      display: none;
    }
  }
</style>

<script>
  function initThread() {
    const thread = document.querySelector<HTMLElement>(".home-thread");
    if (!thread) return;

    const onScroll = () => {
      const doc = document.documentElement;
      const travel = doc.scrollHeight - window.innerHeight;
      const progress = travel > 0 ? Math.min(1, Math.max(0, window.scrollY / travel)) : 0;
      thread.style.setProperty("--thread-progress", String(progress));
    };

    onScroll();
    thread.classList.add("is-ready");
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", initThread);
</script>
