---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

/** Tag scent: warm for backend, cool for Agent, brisk for digests. */
const lowered = tagName.toLowerCase();
let scent: "backend" | "agent" | "digest" | null = null;
if (lowered.includes("最新速递")) scent = "digest";
else if (lowered.includes("后端") || lowered.includes("请求过境")) scent = "backend";
else if (lowered.includes("agent") || lowered.includes("拆解")) scent = "agent";
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    data-tag-scent={scent}
    class:list={[
      "tag-chip flex items-center gap-0.5",
      "border-foreground border-b-2 border-dashed",
      "hover:border-accent hover:text-accent hover:-mt-0.5",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
    {
      count !== undefined && (
        <span class="tag-count font-mono" aria-label={`${count} 篇`}>
          × {count}
        </span>
      )
    }
  </a>
</li>
