---
import type { CollectionEntry } from "astro:content";
import { getPostSlugPath, getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  /** Published within ~48h — show a fading ink mark. */
  isFresh?: boolean;
  /** Seeded “today’s read” — clay rule on the left. */
  isTodayPick?: boolean;
  /** Revised within ~7d — show a quiet “改过” echo. */
  isRevised?: boolean;
  /** Newest post on the homepage — breathes once when revealed. */
  isNewest?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  id,
  data,
  filePath,
  isFresh = false,
  isTodayPick = false,
  isRevised = false,
  isNewest = false,
} = Astro.props;

const { title, description, ...props } = data;
const transitionName = toTransitionName(title);
const path = getPostSlugPath(id, filePath);
const slug = path.split("/").filter(Boolean).pop() ?? id;

/** Column scent: a warm hairline for backend notes, a cool one for Agent teardowns. */
const tags = (data.tags ?? []).map(tag => tag.toLowerCase());
let column: "backend" | "agent" | null = null;
if (tags.some(tag => tag.includes("后端") || tag.includes("请求过境"))) {
  column = "backend";
} else if (tags.some(tag => tag.includes("agent") || tag.includes("拆解"))) {
  column = "agent";
}
---

<li
  class:list={[
    "post-card my-6",
    {
      "is-fresh": isFresh,
      "is-today-pick": isTodayPick,
      "is-newest": isNewest,
    },
  ]}
  data-term-slug={slug}
  data-column={column}
>
  {
    isTodayPick && (
      <span class="post-card-today-label font-mono" aria-hidden="true">
        今日一篇
      </span>
    )
  }
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    draggable="true"
    data-term-slug={slug}
    class:list={[
      "text-accent font-serif inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      transition:name={transitionName}
      class="post-card-title inline"
      data-vt={transitionName}
    >
      {title}
    </Heading>
    {
      isFresh && (
        <span class="post-card-ink font-mono" title="近两天发布" aria-label="新">
          新
        </span>
      )
    }
    {
      !isFresh && isRevised && (
        <span
          class="post-card-revised font-mono"
          title="近一周更新过"
          aria-label="改过"
        >
          改过
        </span>
      )
    }
  </a>
  <Datetime {...props} />
  <p>{description}</p>
</li>
