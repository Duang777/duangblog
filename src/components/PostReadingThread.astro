---
/**
 * Reading rail sits in the left margin — it must not push the article
 * body away from the title alignment.
 */
---

<aside class="post-rail" aria-hidden="true">
  <div class="post-rail-copy">
    <p class="post-chapter-trail font-mono" data-rail="trail"></p>
    <p class="post-chapter-page font-mono" data-rail="page"></p>
  </div>
  <div class="post-thread">
    <span class="post-thread-line"></span>
    <span class="post-thread-fill"></span>
    <span class="post-thread-stitch"></span>
  </div>
</aside>

<style>
  /* Keep the wrap as a normal block so #article stays under the title. */
  :global(.post-body-wrap) {
    position: relative;
    display: block;
  }

  .post-rail {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-block-end: 0.5rem;
    /* Park in the page margin, clear of the prose column. */
    inset-inline-start: -4.75rem;
    width: 3.75rem;
    display: grid;
    grid-template-columns: 1fr 1px;
    column-gap: 0.55rem;
    align-items: start;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s ease;
    z-index: 2;
  }

  .post-rail.is-ready {
    opacity: 1;
  }

  .post-rail-copy {
    position: sticky;
    top: 30vh;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    text-align: end;
  }

  .post-chapter-trail,
  .post-chapter-page {
    position: static;
    margin: 0;
    max-width: 3.2rem;
    opacity: 0;
  }

  .post-chapter-trail {
    font-size: 0.62rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-chapter-trail::before {
    content: "¶ ";
    color: color-mix(in oklab, var(--accent) 70%, var(--muted-foreground));
  }

  .post-chapter-trail.is-shown,
  .post-chapter-page.is-shown {
    opacity: 0.85;
  }

  .post-chapter-page {
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: color-mix(in oklab, var(--accent) 65%, var(--muted-foreground));
  }

  .post-thread {
    position: sticky;
    top: 28vh;
    width: 1px;
    height: 42vh;
    min-height: 12rem;
  }

  .post-thread-line {
    position: absolute;
    inset: 0;
    border-inline-start: 1px dashed
      color-mix(in oklab, var(--border) 70%, transparent);
  }

  .post-thread-fill {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 1px;
    height: calc(var(--read-progress, 0) * 100%);
    background: color-mix(in oklab, var(--accent) 55%, transparent);
  }

  .post-thread-stitch {
    position: absolute;
    inset-inline-start: 50%;
    top: calc(var(--read-progress, 0) * 100%);
    width: 5px;
    height: 5px;
    margin-inline-start: -2.5px;
    margin-top: -2.5px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 78%, transparent);
  }

  /* Not enough margin: hide rather than crowd the prose. */
  @media (max-width: 1100px) {
    .post-rail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-rail {
      transition: none;
    }
  }
</style>

<script>
  function initPostThread() {
    const rail = document.querySelector<HTMLElement>(".post-rail");
    const thread = document.querySelector<HTMLElement>(".post-thread");
    const article = document.getElementById("article");
    if (!rail || !thread || !article) return;

    const onScroll = () => {
      const rect = article.getBoundingClientRect();
      const top = window.scrollY + rect.top;
      const height = Math.max(1, article.offsetHeight);
      const view = window.scrollY + window.innerHeight * 0.35;
      const progress = Math.min(1, Math.max(0, (view - top) / height));
      thread.style.setProperty("--read-progress", String(progress));
    };

    onScroll();
    rail.classList.add("is-ready");
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", initPostThread);
</script>
