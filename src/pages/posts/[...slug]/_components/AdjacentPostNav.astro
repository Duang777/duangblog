---
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
  /** Series / column label, e.g. 请求过境 */
  label?: string;
  /** 1-based index within the series */
  index?: number;
  /** Total posts in the series */
  total?: number;
  /** Shared non-series tag with the current post */
  sharedTag?: string;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

function noteLabel(post: NonNullable<AdjacentPost>, fallback: string) {
  if (post.label && post.index && post.total) {
    return `${fallback} · 同属 · ${post.label} · ${post.index}/${post.total}`;
  }
  if (post.label && post.index) {
    return `${fallback} · 同属 · ${post.label} · 第 ${post.index} 篇`;
  }
  if (post.sharedTag) {
    return `${fallback} · 同属 · ${post.sharedTag}`;
  }
  return fallback;
}
---

{
  (prevPost || nextPost) && (
    <nav class="adjacent-notes" data-pagefind-ignore aria-label="同专栏前后篇">
      {prevPost && (
        <a
          href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
          class="adjacent-notes-item is-prev"
        >
          <span class="adjacent-notes-mark font-mono">
            {noteLabel(prevPost, "上一篇")}
          </span>
          <span class="adjacent-notes-title">{prevPost.title}</span>
        </a>
      )}
      {nextPost && (
        <a
          href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
          class="adjacent-notes-item is-next"
        >
          <span class="adjacent-notes-mark font-mono">
            {noteLabel(nextPost, "下一篇")}
          </span>
          <span class="adjacent-notes-title">{nextPost.title}</span>
        </a>
      )}
    </nav>
  )
}
