---
/**
 * Paper-corner fold that scrolls back to the top.
 * Replaces the round FAB with something quieter.
 */
---

<button
  type="button"
  class="paper-corner-top"
  data-button="back-to-top"
  aria-label="折角回顶"
>
  <span class="paper-corner-top-fold" aria-hidden="true"></span>
  <span class="paper-corner-top-label font-mono">回顶</span>
</button>

<script is:inline data-astro-rerun>
  (function () {
    const btn = document.querySelector("[data-button='back-to-top']");
    if (!btn || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";

    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, left: 0, behavior: "smooth" });
    });

    let lastVisible = null;
    const onScroll = () => {
      const root = document.documentElement;
      const total = root.scrollHeight - root.clientHeight;
      const visible = total > 0 && root.scrollTop / total > 0.28;
      if (visible === lastVisible) return;
      lastVisible = visible;
      btn.classList.toggle("is-shown", visible);
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", onScroll),
      { once: true }
    );
  })();
</script>
