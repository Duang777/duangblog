---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import HomeIdeaJarMini from "@/components/HomeIdeaJarMini.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const zh = getSortedPosts(posts, "zh-CN");
  const en = getSortedPosts(posts, "en");
  // Enough pages for the larger language; each locale slices its own list at render.
  const longer = zh.length >= en.length ? zh : en;
  return paginate(longer, { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const sorted = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft),
  locale
);
const pageSize = config.posts.perPage;
const lastPage = Math.max(1, Math.ceil(sorted.length / pageSize));
const currentPage = Math.min(page.currentPage, lastPage);
const start = (currentPage - 1) * pageSize;
const pagePosts = sorted.slice(start, start + pageSize);
const totalPosts = sorted.length;

const t = useTranslations(locale);

const localePage = {
  ...page,
  data: pagePosts,
  currentPage,
  lastPage,
  total: sorted.length,
  size: pageSize,
  url: {
    ...page.url,
    prev:
      currentPage > 1
        ? currentPage === 2
          ? page.url.first ?? page.url.current.replace(/\/\d+\/?$/, "/")
          : page.url.current.replace(
              /\/\d+\/?$/,
              `/${currentPage - 1}/`
            )
        : undefined,
    next:
      currentPage < lastPage
        ? page.url.current.includes(`/${currentPage}`)
          ? page.url.current.replace(
              `/${currentPage}`,
              `/${currentPage + 1}`
            )
          : `${page.url.current.replace(/\/?$/, "/")}${currentPage + 1}/`
        : undefined,
  },
};
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.pages.postsTitle}
    pageDesc={t.pages.postsDesc}
    backLabel={t.nav.posts}
  >
    <div class="list-jar-aside">
      <HomeIdeaJarMini totalPosts={totalPosts} />
    </div>
    <ul>
      {pagePosts.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination page={localePage} />

  <Footer noMarginTop={lastPage > 1} />
</Layout>
