---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll, slugifyStr } from "@/utils/slugify";
import { getPostSlugPath } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import { getTagIntro } from "@/data/tag-intros";
import { resolveColumnJar } from "@/data/column-jars";
import HomeIdeaJarMini from "@/components/HomeIdeaJarMini.astro";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  // Tags come from all posts so EN/ZH share the same tag routes.
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const zhTagPosts = getSortedPosts(
      posts.filter(
        ({ data }) =>
          (data.lang ?? "zh-CN") === "zh-CN" &&
          slugifyAll(data.tags).includes(tag)
      ),
      "zh-CN"
    );
    const enTagPosts = getSortedPosts(
      posts.filter(
        ({ data }) =>
          data.lang === "en" && slugifyAll(data.tags).includes(tag)
      ),
      "en"
    );
    const longer =
      zhTagPosts.length >= enTagPosts.length ? zhTagPosts : enTagPosts;
    const tagSlugs = longer.map(p => {
      const path = getPostSlugPath(p.id, p.filePath);
      return path.split("/").filter(Boolean).pop() ?? p.id;
    });

    return paginate(longer.length > 0 ? longer : zhTagPosts, {
      params: { tag },
      props: { tagName, tagSlugs },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName, tagSlugs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const tagSlug = slugifyStr(tagName);
const localeTagPosts = getSortedPosts(
  (await getCollection("posts", ({ data }) => !data.draft)).filter(({ data }) =>
    slugifyAll(data.tags).includes(tagSlug)
  ),
  locale
);
const pageSize = config.posts.perPage;
const lastPage = Math.max(1, Math.ceil(localeTagPosts.length / pageSize));
const currentPage = Math.min(page.currentPage, lastPage);
const start = (currentPage - 1) * pageSize;
const pagePosts = localeTagPosts.slice(start, start + pageSize);
const tagIntro = getTagIntro(tagName);
const totalInTag = localeTagPosts.length;
const notebookStat =
  locale === "en"
    ? `${totalInTag} notes tagged ${tagName}`
    : `这本里有 ${totalInTag} 篇关于${tagName}的笔记`;
const jar = resolveColumnJar(tagName);

const localePage = {
  ...page,
  data: pagePosts,
  currentPage,
  lastPage,
  total: totalInTag,
  size: pageSize,
};
---

<Layout title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={tagIntro}
    backLabel={`${t.nav.tags} · ${tagName}`}
  >
    <div class="list-jar-aside is-column-jar">
      <HomeIdeaJarMini
        totalPosts={localeTagPosts.length}
        kind={jar.kind}
        caption={jar.caption}
        hint={jar.hint}
        columnTag={tagName}
        tagSlugs={tagSlugs}
      />
    </div>
    <p class="tag-notebook-stat font-mono" data-tag-name={tagName}>
      {notebookStat}
    </p>
    <ul class="tag-post-list" data-tag-name={tagName}>
      {pagePosts.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination page={localePage} />

  <Footer noMarginTop={lastPage > 1} />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const list = document.querySelector<HTMLElement>(".tag-post-list");
    const tag = list?.dataset.tagName?.trim();
    if (!list || !tag || tag.length < 2) return;

    // One soft underline pass over matching words in titles/descriptions.
    const walker = document.createTreeWalker(list, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    let node: Node | null;
    while ((node = walker.nextNode())) {
      if (node.textContent?.includes(tag)) nodes.push(node as Text);
    }

    for (const textNode of nodes) {
      const parent = textNode.parentElement;
      if (!parent || parent.closest("a.tag-chip")) continue;
      const parts = textNode.textContent?.split(tag);
      if (!parts || parts.length < 2) continue;

      const frag = document.createDocumentFragment();
      parts.forEach((part, i) => {
        if (part) frag.appendChild(document.createTextNode(part));
        if (i < parts.length - 1) {
          const mark = document.createElement("span");
          mark.className = "tag-word-mark";
          mark.textContent = tag;
          frag.appendChild(mark);
        }
      });
      textNode.replaceWith(frag);
    }

    requestAnimationFrame(() => {
      list.classList.add("is-marked");
    });
  });
</script>
