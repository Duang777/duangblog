---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HomeHero from "@/components/HomeHero.astro";
import HomeDateStamp from "@/components/HomeDateStamp.astro";
import HomeWritingStatus from "@/components/HomeWritingStatus.astro";
import HomeBrandWhisper from "@/components/HomeBrandWhisper.astro";
import HomePhenology from "@/components/HomePhenology.astro";
import HomeIdeaJar from "@/components/HomeIdeaJar.astro";
import HomeColumnSection from "@/components/HomeColumnSection.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostSlugPath, getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";
import type { TermPost } from "@/scripts/home-term";
import { getReadingMinutes } from "@/utils/readingTime";
import {
  getHomeColumns,
  getHomeMiscColumn,
  type HomeColumnDef,
} from "@/data/home-columns";
import type { CollectionEntry } from "astro:content";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts, locale);
const homePath = getRelativeLocaleUrl(locale, "");
const homeColumns = getHomeColumns(locale);
const homeMiscColumn = getHomeMiscColumn(locale);

const FRESH_MS = 48 * 60 * 60 * 1000;
const REVISED_MS = 7 * 24 * 60 * 60 * 1000;
const nowMs = Date.now();
const daySeed = Math.floor(nowMs / 86_400_000);
const todayPickId =
  sortedPosts.length > 0
    ? sortedPosts[daySeed % sortedPosts.length]!.id
    : null;
const newestId = sortedPosts.length > 0 ? sortedPosts[0]!.id : null;

function isFreshPost(pubDatetime: Date) {
  return nowMs - pubDatetime.getTime() < FRESH_MS;
}

function isRevisedPost(pubDatetime: Date, modDatetime?: Date | null) {
  if (!modDatetime) return false;
  if (modDatetime.getTime() <= pubDatetime.getTime()) return false;
  return nowMs - modDatetime.getTime() < REVISED_MS;
}

function postSlug(post: CollectionEntry<"posts">) {
  const path = getPostSlugPath(post.id, post.filePath);
  return path.split("/").filter(Boolean).pop() ?? post.id;
}

const hubSlugs = new Set(
  homeColumns.map(c => c.hubSlug).filter((s): s is string => Boolean(s))
);

/** Articles only — hub landing pages stay out of the “latest” lists. */
const articlePosts = sortedPosts.filter(p => !hubSlugs.has(postSlug(p)));

type ColumnBucket = {
  column: HomeColumnDef;
  posts: CollectionEntry<"posts">[];
  totalCount: number;
};

const claimed = new Set<string>();
const columnBuckets: ColumnBucket[] = homeColumns.map(column => {
  // Claim every matching article so overflow does not leak into 随笔.
  const matchedAll = articlePosts.filter(p => {
    if (claimed.has(p.id)) return false;
    return column.match(p.data.tags ?? []);
  });
  matchedAll.forEach(p => claimed.add(p.id));
  return {
    column,
    posts: matchedAll.slice(0, column.limit),
    totalCount: matchedAll.length,
  };
});

const miscAll = articlePosts.filter(p => !claimed.has(p.id));
const miscPosts = miscAll.slice(0, homeMiscColumn.limit);
const showMisc = miscPosts.length > 0;

const termPosts: TermPost[] = sortedPosts.map(post => {
  const path = getPostSlugPath(post.id, post.filePath);
  const slug = path.split("/").filter(Boolean).pop() ?? post.id;
  const d = post.data.pubDatetime;
  const pubDate = [
    d.getFullYear(),
    String(d.getMonth() + 1).padStart(2, "0"),
    String(d.getDate()).padStart(2, "0"),
  ].join("-");
  const body = post.body ?? "";
  return {
    slug,
    title: post.data.title,
    href: getPostUrl(post.id, post.filePath, locale),
    description: post.data.description,
    tags: post.data.tags ?? [],
    draft: post.data.draft,
    pubDate,
    minutes: getReadingMinutes(body),
    chars: body.replace(/\s+/g, "").length,
    revisions: (post.data.revisions ?? []).map(rev => ({
      date: rev.date.toISOString().slice(0, 10),
      note: rev.note,
    })),
  };
});

const newestSlug = termPosts.length > 0 ? termPosts[0]!.slug : null;
const todayPickIndex = todayPickId
  ? sortedPosts.findIndex(p => p.id === todayPickId)
  : -1;
const todayPickSlug =
  todayPickIndex >= 0 ? termPosts[todayPickIndex]!.slug : null;
const todayPickHref =
  todayPickIndex >= 0 ? termPosts[todayPickIndex]!.href : null;

/** Only ideas safe to show in the public terminal. */
const termIdeas = [
  "[念头] 第二次请求偶发断 — IdleTimeout 和代理 idle 是否不一致",
  "[已发] Context 传到 DB — r.Context 取消时机与 QueryContext",
  "[念头] 专栏目录要不要按机制而不是按项目排",
];
---

<Layout>
  <Header />
  <HomeBrandWhisper />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="w-full"
  >
    <HomeHero locale={locale} posts={termPosts} ideas={termIdeas} />

    <div class="home-seam" aria-hidden="true"></div>

    <div class="app-layout home-aside-notes-wrap">
      <div class="home-aside-notes">
        <HomeIdeaJar
          totalPosts={sortedPosts.length}
          todayPickSlug={todayPickSlug}
          todayPickHref={todayPickHref}
          fallbackSlug={newestSlug}
        />
        <HomePhenology />
      </div>
    </div>

    <div class="app-layout">
      <div id="posts" class="home-columns scroll-mt-24">
        <div class="home-columns-meta">
          <HomeDateStamp />
          <HomeWritingStatus />
        </div>

        {
          columnBuckets.map(({ column, posts: columnPosts, totalCount }) => (
            <HomeColumnSection
              column={column}
              posts={columnPosts}
              totalCount={totalCount}
              locale={locale}
              todayPickId={todayPickId}
              newestId={newestId}
              isFreshPost={isFreshPost}
              isRevisedPost={isRevisedPost}
            />
          ))
        }

        {
          showMisc && (
            <HomeColumnSection
              column={homeMiscColumn}
              posts={miscPosts}
              totalCount={miscAll.length}
              locale={locale}
              todayPickId={todayPickId}
              newestId={newestId}
              isFreshPost={isFreshPost}
              isRevisedPost={isRevisedPost}
            />
          )
        }
      </div>

      <div class="my-8 flex items-center justify-center gap-4">
        <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
          {t.home.allPosts}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { applyReadEcho } from "@/scripts/home-term";

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
      sessionStorage.removeItem("backLabel");
    }

    const seam = document.querySelector<HTMLElement>(".home-seam");
    const hero = document.getElementById("hero");
    if (seam && hero) {
      const seamReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (!seamReduced) {
        const onSeamScroll = () => {
          const rect = hero.getBoundingClientRect();
          const near = Math.min(1, Math.max(0, 1 + rect.bottom / rect.height));
          seam.style.setProperty("--seam-shift", String((1 - near) * 10));
        };
        onSeamScroll();
        window.addEventListener("scroll", onSeamScroll, { passive: true });
      }
    }

    const cards = document.querySelectorAll<HTMLElement>(".post-card");
    if (cards.length === 0) return;

    applyReadEcho();

    try {
      const last = sessionStorage.getItem("term-last-post");
      if (last) {
        const card = document.querySelector<HTMLElement>(
          `.post-card.is-today-pick[data-term-slug="${CSS.escape(last)}"]`
        );
        card?.classList.add("is-returned-fold");
      }
    } catch {
      // ignore
    }

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const softNav = Boolean(
      (window as unknown as { __softNav?: boolean }).__softNav
    );
    if (reduced || softNav) {
      cards.forEach(card => card.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const delay = Number(el.dataset.revealDelay ?? 0);
            window.setTimeout(() => el.classList.add("is-visible"), delay);
            observer.unobserve(el);
          });
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
      );

      cards.forEach((card, i) => {
        card.dataset.revealDelay = String(Math.min(i * 70, 280));
        observer.observe(card);
      });
    }

    let activeCard: HTMLElement | null = null;
    const onCatalogScroll = () => {
      const band = window.innerHeight * 0.38;
      let next: HTMLElement | null = null;
      for (const card of cards) {
        const top = card.getBoundingClientRect().top;
        if (top <= band) next = card;
        else break;
      }
      if (next === activeCard) return;
      activeCard?.classList.remove("is-catalog-focus");
      activeCard = next;
      activeCard?.classList.add("is-catalog-focus");
    };
    onCatalogScroll();
    window.addEventListener("scroll", onCatalogScroll, { passive: true });
  });
</script>
