---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HomeHero from "@/components/HomeHero.astro";
import HomeDateStamp from "@/components/HomeDateStamp.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostSlugPath, getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";
import type { TermPost } from "@/scripts/home-term";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const FRESH_MS = 48 * 60 * 60 * 1000;
const nowMs = Date.now();
const daySeed = Math.floor(nowMs / 86_400_000);
const todayPickId =
  sortedPosts.length > 0
    ? sortedPosts[daySeed % sortedPosts.length]!.id
    : null;

function isFreshPost(pubDatetime: Date) {
  return nowMs - pubDatetime.getTime() < FRESH_MS;
}

const termPosts: TermPost[] = sortedPosts.map(post => {
  const path = getPostSlugPath(post.id, post.filePath);
  const slug = path.split("/").filter(Boolean).pop() ?? post.id;
  return {
    slug,
    title: post.data.title,
    href: getPostUrl(post.id, post.filePath, locale),
    description: post.data.description,
    tags: post.data.tags ?? [],
    draft: post.data.draft,
  };
});

/** Only ideas safe to show in the public terminal. */
const termIdeas = [
  "[念头] 第二次请求偶发断 — IdleTimeout 和代理 idle 是否不一致",
  "[已发] Context 传到 DB — r.Context 取消时机与 QueryContext",
  "[念头] 专栏目录要不要按机制而不是按项目排",
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="w-full"
  >
    <HomeHero locale={locale} posts={termPosts} ideas={termIdeas} />

    <div class="app-layout">
      {
        featuredPosts.length > 0 && (
          <section
            id="posts"
            class:list={[
              "scroll-mt-24 pt-14 pb-6",
              { "border-border border-b": recentPosts.length > 0 },
            ]}
          >
            <div class="mb-1 flex items-end justify-between gap-4">
              <h2 class="font-serif text-2xl font-semibold tracking-wide">
                {t.home.featured}
              </h2>
              <HomeDateStamp />
            </div>
            <ul>
              {featuredPosts.map(data => (
                <Card
                  variant="h3"
                  {...data}
                  isFresh={isFreshPost(data.data.pubDatetime)}
                  isTodayPick={data.id === todayPickId}
                />
              ))}
            </ul>
          </section>
        )
      }

      {
        recentPosts.length > 0 && (
          <section
            id={featuredPosts.length > 0 ? "recent-posts" : "posts"}
            class="scroll-mt-24 pt-14 pb-6"
          >
            <div class="mb-1 flex items-end justify-between gap-4">
              <h2 class="font-serif text-2xl font-semibold tracking-wide">
                {t.home.recentPosts}
              </h2>
              {featuredPosts.length === 0 && <HomeDateStamp />}
            </div>
            <ul>
              {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                <Card
                  variant="h3"
                  {...data}
                  isFresh={isFreshPost(data.data.pubDatetime)}
                  isTodayPick={data.id === todayPickId}
                />
              ))}
            </ul>
          </section>
        )
      }

      <div class="my-8 text-center">
        <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
          {t.home.allPosts}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    const cards = document.querySelectorAll<HTMLElement>(".post-card");
    if (cards.length === 0) return;

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (reduced) {
      cards.forEach(card => card.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = Number(el.dataset.revealDelay ?? 0);
          window.setTimeout(() => el.classList.add("is-visible"), delay);
          observer.unobserve(el);
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
    );

    cards.forEach((card, i) => {
      card.dataset.revealDelay = String(Math.min(i * 70, 280));
      observer.observe(card);
    });
  });
</script>
